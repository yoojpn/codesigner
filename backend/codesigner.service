[Unit]
Description=Codesigner Backend
After=network.target litellm.service
Requires=litellm.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/codesigner/backend
EnvironmentFile=/home/ubuntu/codesigner/backend/.env
ExecStart=/home/ubuntu/.local/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
